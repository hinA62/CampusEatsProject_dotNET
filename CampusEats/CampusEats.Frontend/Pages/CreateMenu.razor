@page "/menus/create"
@using CampusEatsFrontend.Models.Menu
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject NavigationManager Navigation
@inject MenuService MenuService
@inject MenuItemService MenuItemService
@inject AuthService AuthService

<PageTitle>Create Menu - CampusEats</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title mb-4">Create Menu Collection</h3>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_errorMessage
                        </div>
                    }

                    @if (_isLoadingItems)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading menu items...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="_newMenu" OnValidSubmit="Save">
                            <div class="mb-3">
                                <label class="form-label">Name <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_newMenu.Name" placeholder="e.g., Breakfast Menu" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Category <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_newMenu.Category">
                                    @foreach (var cat in Enum.GetValues<MenuCategory>())
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Dietary Restrictions</label>
                                <InputSelect class="form-select" @bind-Value="_newMenu.Restrictions">
                                    @foreach (var rest in Enum.GetValues<DietaryRestrictions>())
                                    {
                                        <option value="@rest">@rest</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Preț (RON)</label>
                                <InputNumber class="form-control" @bind-Value="_newMenu.Price" step="0.01" />
                                <small class="form-text text-muted">Optional - total price for the menu</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Image URL</label>
                                <InputText class="form-control" @bind-Value="_newMenu.ImageUrl" placeholder="https://example.com/image.jpg" />
                                <small class="form-text text-muted">Optional - URL to menu image</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Select Menu Items</label>
                                @if (_availableMenuItems == null || !_availableMenuItems.Any())
                                {
                                    <div class="alert alert-warning">
                                        No menu items available. Please <a href="/menu-items/create">create menu items</a> first.
                                    </div>
                                }
                                else
                                {
                                    <div class="border rounded p-3" style="max-height: 300px; overflow-y: auto;">
                                        @foreach (var item in _availableMenuItems)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" 
                                                       id="item-@item.Id" 
                                                       checked="@_selectedItemIds.Contains(item.Id)"
                                                       @onchange="@(() => ToggleMenuItem(item.Id))" />
                                                <label class="form-check-label" for="item-@item.Id">
                                                    <strong>@item.Name</strong> - @item.Price.ToString("F2") RON
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    <small class="form-text text-muted">Selected: @_selectedItemIds.Count item(s)</small>
                                }
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @if (_isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Creating...</span>
                                    }
                                    else
                                    {
                                        <span>Create Menu</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    readonly CreateMenuRequest _newMenu = new();
    private List<MenuItemDto>? _availableMenuItems;
    private HashSet<Guid> _selectedItemIds = new();
    private string _errorMessage = string.Empty;
    private bool _isLoadingItems = true;
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        if (AuthService.CurrentUser?.Role != "Admin")
        {
            Navigation.NavigateTo("/menus");
            return;
        }

        _availableMenuItems = await MenuItemService.GetAllMenuItemsAsync();
        _isLoadingItems = false;
    }

    private void ToggleMenuItem(Guid itemId)
    {
        if (_selectedItemIds.Contains(itemId))
        {
            _selectedItemIds.Remove(itemId);
        }
        else
        {
            _selectedItemIds.Add(itemId);
        }
    }

    async Task Save()
    {
        _isSaving = true;
        _errorMessage = string.Empty;

        try
        {
            if (string.IsNullOrWhiteSpace(_newMenu.Name))
            {
                _errorMessage = "Menu name is required.";
                _isSaving = false;
                return;
            }

            _newMenu.ItemIds = _selectedItemIds.ToList();

            var response = await MenuService.CreateMenuAsync(_newMenu);
            
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/menus");
            }
            else
            {
                _errorMessage = "Failed to create menu. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/menus");
    }
}