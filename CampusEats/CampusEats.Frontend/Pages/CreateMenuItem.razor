@page "/menu-items/create"
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject MenuItemService MenuItemService
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Create Menu Item - CampusEats</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title mb-4">Adaugă Menu Item</h3>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_errorMessage
                        </div>
                    }

                    <EditForm Model="@_newItem" OnValidSubmit="@HandleCreate">
                        <div class="mb-3">
                            <label for="name" class="form-label">Nume <span class="text-danger">*</span></label>
                            <InputText id="name" class="form-control" @bind-Value="_newItem.Name" placeholder="e.g., Cheeseburger" />
                        </div>

                        <div class="mb-3">
                            <label for="price" class="form-label">Preț <span class="text-danger">*</span></label>
                            <InputNumber id="price" class="form-control" @bind-Value="_newItem.Price" step="0.01" />
                        </div>

                        <div class="mb-3">
                            <label for="imageUrl" class="form-label">URL Imagine</label>
                            <InputText id="imageUrl" class="form-control" @bind-Value="_newItem.ImageUrl" placeholder="https://example.com/image.jpg" />
                            @if (!string.IsNullOrEmpty(_newItem.ImageUrl))
                            {
                                <div class="mt-2">
                                    <img src="@_newItem.ImageUrl" alt="Preview" style="max-width: 200px; max-height: 200px;" class="img-thumbnail" />
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-block">Alergeni</label>
    
                            <div class="border p-3 rounded allergens-box">
                                @foreach (var allergen in _availableAllergens)
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               id="@allergen" 
                                               checked="@(_selectedAllergens.Contains(allergen))"
                                               @onchange="() => ToggleAllergen(allergen)" />
                                        <label class="form-check-label" for="@allergen">
                                            @allergen
                                        </label>
                                    </div>
                                }
                            </div>
                            <small class="form-text text-muted">Selectați alergenii aplicați.</small>
    
                            @if (!_selectedAllergens.Any())
                            {
                                <p class="text-success mt-2">Niciun alergen selectat.</p>
                            }
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary btn-cancel" @onclick="Cancel">Anulează</button>
                            <button type="submit" class="btn btn-primary" disabled="@_isLoading">
                                @if (_isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Se adaugă...</span>
                                }
                                else
                                {
                                    <span>Menu Item adăugat!</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CreateMenuItemRequest _newItem = new();
    
    private string _errorMessage = string.Empty;
    private bool _isLoading = false;

    private List<string> _availableAllergens = new List<string>
    {
        "Dairy", "Milk", "Lactose", "Cheese", "Egg", "Gluten", 
        "Wheat", "Nut", "Peanut", "Almond", "Cashew", 
        "Fish", "Molluscs", "Shellfish", "Citrus", "Soya"
    };
    
    private List<string> _selectedAllergens = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        if (AuthService.CurrentUser?.Role != "Admin")
        {
            Navigation.NavigateTo("/menu-items");
        }
    }
    
    private void ToggleAllergen(string allergen)
    {
        if (_selectedAllergens.Contains(allergen))
        {
            _selectedAllergens.Remove(allergen);
        }
        else
        {
            _selectedAllergens.Add(allergen);
        }
    }

    private async Task HandleCreate()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            if (string.IsNullOrWhiteSpace(_newItem.Name))
            {
                _errorMessage = "Numele este obligatoriu.";
                _isLoading = false;
                return;
            }

            if (_newItem.Price <= 0)
            {
                _errorMessage = "Prețul trebuie să fie mai mare decât 0.";
                _isLoading = false;
                return;
            }
            
            _newItem.Allergens = _selectedAllergens;

            if (string.IsNullOrWhiteSpace(_newItem.ImageUrl))
            {
                _newItem.ImageUrl = null;
            }

            var response = await MenuItemService.CreateMenuItemAsync(_newItem);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/menu-items");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Eroare la crearea menu itemului. Status: {response.StatusCode}. Error: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"A intervenit o eroare: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
    
    private void Cancel()
    {
        Navigation.NavigateTo("/menu-items");
    }
}
