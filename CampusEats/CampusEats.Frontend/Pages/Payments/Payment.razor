@page "/payment/{orderId:guid}"
@page "/payment"
@using CampusEatsFrontend.Models.Payment
@using CampusEatsFrontend.Models.Order
@using CampusEatsFrontend.Models.Loyalty
@using CampusEatsFrontend.Models.Menu
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Web
@inject PaymentService PaymentService
@inject OrderService OrderService
@inject LoyaltyService LoyaltyService
@inject MenuService MenuService
@inject MenuItemService MenuItemService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Plată</PageTitle>

<div class="container mt-4 payment-page">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (_isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Se încarccă...</span>
                    </div>
                </div>
            }
            else if (_cartMenuIds.Count == 0 && _cartItemIds.Count == 0)
            {
                <div class="alert alert-danger">
                    <span class="bi bi-exclamation-triangle"></span> Nu există articole în coș.
                </div>
            }
            else
            {
                <!-- Order Summary Card -->
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><span class="bi bi-receipt"></span> Rezumat Comandă</h4>
                    </div>
                    <div class="card-body">
                        <!-- Menus Section -->
                        @if (_cartMenuIds.Count > 0)
                        {
                            <div class="mb-3">
                                <h6 class="mb-2"><strong>Meniuri</strong></h6>
                                @foreach (var menuGroup in _cartMenuIds.GroupBy(id => id))
                                {
                                    var menuId = menuGroup.Key;
                                    var quantity = menuGroup.Count();
                                    var menu = _menuDetails.FirstOrDefault(m => m.Id == menuId);
                                    if (menu != null)
                                    {
                                        <div class="ms-3 mb-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span>
                                                    @menu.Name@(quantity > 1 ? $" x{quantity}" : "")
                                                </span>
                                                <span>@((menu.Price * quantity)?.ToString("F2") ?? "0.00") RON</span>
                                            </div>
                                            <!-- Items din meniu -->
                                            @if (menu.ItemIds.Count > 0)
                                            {
                                                <div class="ms-3">
                                                    @foreach (var itemId in menu.ItemIds)
                                                    {
                                                        var item = _itemDetails.FirstOrDefault(i => i.Id == itemId);
                                                        if (item != null)
                                                        {
                                                            <div style="font-size: 0.9rem; opacity: 0.75; color: #666;">
                                                                • @item.Name
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <!-- Individual Items Section -->
                        @if (_cartItemIds.Count > 0)
                        {
                            <div class="mb-3">
                                <h6 class="mb-2"><strong>Feluri Individuale</strong></h6>
                                @foreach (var itemGroup in _cartItemIds.GroupBy(id => id))
                                {
                                    var itemId = itemGroup.Key;
                                    var quantity = itemGroup.Count();
                                    var item = _itemDetails.FirstOrDefault(i => i.Id == itemId);
                                    if (item != null)
                                    {
                                        <div class="ms-3 d-flex justify-content-between align-items-center mb-2">
                                            <span>
                                                @item.Name@(quantity > 1 ? $" x{quantity}" : "")
                                            </span>
                                            <span>@((item.Price * quantity).ToString("F2")) RON</span>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <hr />
                            <div class="alert alert-danger mb-0">
                                <span class="bi bi-exclamation-triangle"></span> @_errorMessage
                            </div>
                        }

                        <hr />

                        <!-- Payment Method Selection -->
                        <form>
                            <div class="mb-3">
                                <label class="form-label"><strong>Metoda de Plată</strong></label>
                                <select class="form-select" @bind="_paymentMethod">
                                    <option value="@PaymentMethod.StripeTest">Card Bancar (Stripe)</option>
                                    <option value="@PaymentMethod.MockCard">Numerar la Livrare</option>
                                </select>
                            </div>

                            <!-- Info bar: Stripe test mode - Only show if Card selected -->
                            @if (_paymentMethod == PaymentMethod.StripeTest)
                            {
                                <div class="alert alert-info mb-3" style="color: #2A2A2A;">
                                    <span class="bi bi-info-circle"></span>
                                    Plățile sunt procesate folosind <strong>Stripe Checkout</strong> (test mode).
                                    Folosește cardul de test <code>4242 4242 4242 4242</code>, orice dată din viitor și orice CVC.
                                </div>
                            }

                            <!-- Loyalty Points Section - After payment method -->
                            @if (_loyaltyBalance != null && _loyaltyBalance.Points > 0)
                            {
                                <hr />
                                <div class="card mb-3">
                                    <div class="card-header bg-primary text-white">
                                        <h6 class="mb-0"><span class="bi bi-star-fill"></span> Puncte de Loialitate</h6>
                                    </div>
                                    <div class="card-body">
                                        <p class="mb-2">
                                            Ai <strong>@_loyaltyBalance.Points (de) puncte de loialitate</strong>
                                            (Reducere maxim posibilă: @GetMaxDiscount().ToString("F2") RON)
                                        </p>
                                        <p class="mb-2">
                                            <small class="text-muted">
                                                Nivel: @_loyaltyBalance.CurrentTier |
                                                Cashback: @(_loyaltyBalance.CashbackRate.ToString("F0")) x puncte
                                            </small>
                                        </p>
                                        <div class="input-group">
                                            <span class="input-group-text">Puncte de folosit:</span>
                                            <input type="number"
                                                   class="form-control"
                                                   value="@_pointsToUse"
                                                   @onchange="OnPointsChanged"
                                                   min="0"
                                                   max="@GetMaxPoints()" />
                                            <button type="button" class="btn btn-loyalty" @onclick="UseMaxPoints">Folosește toate</button>
                                        </div>
                                        @if (_pointsToUse > 0)
                                        {
                                            <div class="mt-2">
                                                <p class="mb-1"><strong>Reducere: -@GetPointsDiscount().ToString("F2") RON</strong></p>
                                                <p class="mb-0 text-success"><strong>Cost Final: @GetFinalAmount().ToString("F2") RON</strong></p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Total Section -->
                            <hr />
                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <p class="mb-0"><strong>Total de plată:</strong></p>
                                    <h3 class="mb-0">@GetFinalAmount().ToString("F2") RON</h3>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-grid gap-2">
                                <button type="button"
                                        class="btn btn-primary btn-lg"
                                        @onclick="ProcessPayment"
                                        disabled="@(!CanProcessPayment() || _isProcessing)">
                                    @if (_isProcessing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <span class="bi bi-lock-fill"></span>
                                    Plătește
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="Cancel">
                                    <span class="bi bi-x-circle"></span> Anulează
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


@code {
    [Parameter]
    public Guid OrderId { get; set; }

    private OrderDto? _order;
    private LoyaltyBalanceDto? _loyaltyBalance;
    private List<MenuDto> _menuDetails = new();
    private List<MenuItemDto> _itemDetails = new();
    private List<Guid> _cartMenuIds = new();
    private List<Guid> _cartItemIds = new();
    private decimal _totalPrice = 0;
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private string? _errorMessage;
    private int _pointsToUse = 0;
    private PaymentMethod _paymentMethod = PaymentMethod.StripeTest;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Check if we have query params (new flow) or OrderId (old flow)
        var uri = new Uri(Navigation.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var menusParam = query["menus"];
        var itemsParam = query["items"];

        if (!string.IsNullOrEmpty(menusParam) || !string.IsNullOrEmpty(itemsParam))
        {
            // New flow: load from query params (no order created yet)
            await LoadFromQueryParams(menusParam, itemsParam);
        }
        else if (OrderId != Guid.Empty)
        {
            // Old flow: load existing order
            await LoadOrder();
        }
        else
        {
            _errorMessage = "Invalid payment request.";
            _isLoading = false;
            return;
        }

        await LoadLoyaltyBalance();
        await LoadMenuAndItemDetails();
    }

    private Task LoadFromQueryParams(string? menusParam, string? itemsParam)
    {
        _isLoading = true;

        try
        {
            if (!string.IsNullOrEmpty(menusParam))
            {
                _cartMenuIds = menusParam.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(id => Guid.Parse(id))
                    .ToList();
            }

            if (!string.IsNullOrEmpty(itemsParam))
            {
                _cartItemIds = itemsParam.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(id => Guid.Parse(id))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error parsing cart data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }

        return Task.CompletedTask;
    }

    private async Task LoadOrder()
    {
        _isLoading = true;

        try
        {
            _order = await OrderService.GetOrderByIdAsync(OrderId);
            
            if (_order == null)
            {
                _errorMessage = "Order not found.";
            }
            else
            {
                _cartMenuIds = _order.MenuIDs;
                _cartItemIds = _order.ItemIDs;
                _totalPrice = _order.Price;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading order: {ex.Message}";
        }

        _isLoading = false;
    }

    private async Task LoadLoyaltyBalance()
    {
        try
        {
            _loyaltyBalance = await LoyaltyService.GetLoyaltyBalanceAsync(AuthService.CurrentUser!.UserId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading loyalty balance: {ex.Message}");
        }
    }

    private async Task LoadMenuAndItemDetails()
    {
        try
        {
            // Load all menus
            var allMenus = await MenuService.GetAllMenusAsync();
            if (allMenus != null)
            {
                _menuDetails = allMenus.Where(m => _cartMenuIds.Contains(m.Id)).ToList();
            }

            // Load all items
            var allItems = await MenuItemService.GetAllMenuItemsAsync();
            if (allItems != null)
            {
                var itemIdsInMenus = _menuDetails
                    .SelectMany(m => m.ItemIds)
                    .Concat(_cartItemIds)
                    .Distinct()
                    .ToList();
                
                _itemDetails = allItems.Where(i => itemIdsInMenus.Contains(i.Id)).ToList();
            }

            // Calculate total price WITH QUANTITIES
            decimal totalMenuPrice = 0;
            foreach (var menuId in _cartMenuIds)
            {
                var menu = _menuDetails.FirstOrDefault(m => m.Id == menuId);
                if (menu != null && menu.Price.HasValue)
                {
                    totalMenuPrice += menu.Price.Value;
                }
            }

            decimal totalItemPrice = 0;
            foreach (var itemId in _cartItemIds)
            {
                var item = _itemDetails.FirstOrDefault(i => i.Id == itemId);
                if (item != null)
                {
                    totalItemPrice += item.Price;
                }
            }

            _totalPrice = totalMenuPrice + totalItemPrice;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading menu/item details: {ex.Message}");
        }
    }

    private decimal GetPointsDiscount()
    {
        return _pointsToUse / 100m;
    }

    private decimal GetFinalAmount()
    {
        return _totalPrice - GetPointsDiscount();
    }

    private decimal GetMaxDiscount()
    {
        if (_loyaltyBalance == null) return 0;
        var maxPointsValue = _loyaltyBalance.Points / 100m;
        return Math.Min(maxPointsValue, _totalPrice);
    }

    private int GetMaxPoints()
    {
        if (_loyaltyBalance == null) return 0;
        var maxPointsForOrder = (int)(_totalPrice * 100);
        return Math.Min(_loyaltyBalance.Points, maxPointsForOrder);
    }

    private void UseMaxPoints()
    {
        _pointsToUse = GetMaxPoints();
    }

    private void OnPointsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int value))
        {
            // Clamp the value between 0 and the maximum allowed points
            _pointsToUse = Math.Max(0, Math.Min(value, GetMaxPoints()));
        }
    }

    private bool CanProcessPayment()
    {
        // Both payment methods don't require local card fields (Stripe handles it, MockCard is COD)
        return true;
    }

    private async Task ProcessPayment()
    {
        if (_cartMenuIds.Count == 0 && _cartItemIds.Count == 0)
        {
            _errorMessage = "Nu există articole în coș.";
            return;
        }

        _isProcessing = true;
        _errorMessage = null;

        try
        {
            Guid orderId;

            // Step 1: Create the order FIRST (only if not already created)
            if (OrderId == Guid.Empty)
            {
                var orderRequest = new PlaceOrderRequest
                {
                    ClientId = AuthService.CurrentUser!.UserId,
                    MenuIDs = _cartMenuIds,
                    ItemIDs = _cartItemIds
                };

                var orderResponse = await OrderService.PlaceOrderAsync(orderRequest);

                if (!orderResponse.IsSuccessStatusCode)
                {
                    var error = await orderResponse.Content.ReadAsStringAsync();
                    _errorMessage = $"Failed to create order: {error}";
                    return;
                }

                var jsonOptions = new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true,
                    Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
                };

                var createdOrder = await orderResponse.Content.ReadFromJsonAsync<OrderDto>(jsonOptions);
                if (createdOrder == null)
                {
                    _errorMessage = "Failed to parse created order.";
                    return;
                }

                orderId = createdOrder.Id;
            }
            else
            {
                orderId = OrderId;
            }

            // Step 2: Process payment
            if (_paymentMethod == PaymentMethod.MockCard)
            {
                var request = new CreatePaymentRequest
                {
                    UserId = AuthService.CurrentUser!.UserId,
                    OrderId = orderId,
                    Amount = _totalPrice,
                    Method = PaymentMethod.MockCard,
                    PointsToUse = _pointsToUse > 0 ? _pointsToUse : null
                };

                var response = await PaymentService.CreatePaymentAsync(request);

                if (response.IsSuccessStatusCode)
                {
                    // Navigate to payment success page
                    Navigation.NavigateTo("/payment-success");
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    _errorMessage = $"Payment failed: {error}";
                }
            }
            else if (_paymentMethod == PaymentMethod.StripeTest)
            {
                var stripeRequest = new CreateStripeCheckoutSessionRequest
                {
                    UserId = AuthService.CurrentUser!.UserId,
                    OrderId = orderId,
                    PointsToUse = _pointsToUse > 0 ? _pointsToUse : null
                };

                var checkoutUrl = await PaymentService.CreateStripeCheckoutSessionAsync(stripeRequest);

                if (string.IsNullOrEmpty(checkoutUrl))
                {
                    _errorMessage = "Could not create Stripe checkout session.";
                }
                else
                {
                    Navigation.NavigateTo(checkoutUrl, forceLoad: true);
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error processing payment: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/orders");
    }
}
