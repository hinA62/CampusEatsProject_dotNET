@page "/payment/{orderId:guid}"
@using CampusEatsFrontend.Models.Payment
@using CampusEatsFrontend.Models.Order
@using CampusEatsFrontend.Models.Loyalty
@using CampusEatsFrontend.Services
@using Microsoft.AspNetCore.Components.Web
@inject PaymentService PaymentService
@inject OrderService OrderService
@inject LoyaltyService LoyaltyService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Payment - CampusEats</PageTitle>

<div class="container mt-4 payment-page">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (_isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            }
            else if (_order == null)
            {
                <div class="alert alert-danger">
                    <span class="bi bi-exclamation-triangle"></span> Order not found.
                </div>
            }
            else
            {
                <!-- Order Summary Card -->
                <div class="card shadow mb-4">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><span class="bi bi-receipt"></span> Order Summary</h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-6">
                                <p class="mb-1"><strong>Order ID:</strong></p>
                                <p class="text-muted"><code>@_order.Id.ToString().Substring(0, 13)...</code></p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-1"><strong>Status:</strong></p>
                                <p><span class="badge bg-info">@_order.Status</span></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1"><strong>Items:</strong></p>
                                <p class="text-muted">@_order.MenuIDs.Count menus, @_order.ItemIDs.Count items</p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-1"><strong>Order Total:</strong></p>
                                <h3 class="text-primary mb-0">$@_order.Price.ToString("F2")</h3>
                            </div>
                        </div>

                        @if (_loyaltyBalance != null && _loyaltyBalance.Points > 0)
                        {
                            <hr />
                            <div class="alert alert-success mb-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong><span class="bi bi-star-fill"></span> Loyalty Points Available:</strong>
                                        <p class="mb-0">
                                            You have <strong>@_loyaltyBalance.Points points</strong>
                                            (= $@((_loyaltyBalance.Points / 100m).ToString("F2")) discount)
                                        </p>
                                        <small class="text-muted">
                                            Tier: @_loyaltyBalance.CurrentTier |
                                            Cashback: @(_loyaltyBalance.CashbackRate.ToString("F0"))x base points
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">
                        <span class="bi bi-exclamation-triangle"></span> @_errorMessage
                    </div>
                }

                @if (_paymentSuccess)
                {
                    <div class="card shadow border-success">
                        <div class="card-body text-center py-5">
                            <div class="mb-4">
                                <span class="bi bi-check-circle text-success" style="font-size: 4rem;"></span>
                            </div>
                            <h3 class="text-success mb-3">Payment Successful!</h3>
                            <p class="text-muted mb-4">Your order has been paid successfully.</p>
                            <p class="mb-3">
                                <strong>Loyalty Points Earned:</strong>
                                <span class="badge bg-warning text-dark fs-5">+@((int)GetFinalAmount()) points</span>
                            </p>
                            <button class="btn btn-primary" @onclick="GoToOrders">
                                <span class="bi bi-clipboard-check"></span> View My Orders
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow">
                        <div class="card-header bg-success text-white">
                            <h4 class="mb-0"><span class="bi bi-credit-card"></span> Payment Details</h4>
                        </div>
                        <div class="card-body">

                            <!-- Info bar: Stripe test mode -->
                            <div class="alert alert-info">
                                <span class="bi bi-info-circle"></span>
                                Payments are processed via <strong>Stripe Checkout</strong> (test mode).
                                Use the test card <code>4242 4242 4242 4242</code>, any future expiry date and any CVC.
                            </div>

                            @if (_loyaltyBalance != null && _loyaltyBalance.Points > 0)
                            {
                                <div class="card mb-3 border-warning">
                                    <div class="card-header bg-warning text-dark">
                                        <h6 class="mb-0"><span class="bi bi-star-fill"></span> Use Loyalty Points</h6>
                                    </div>
                                    <div class="card-body">
                                        <p class="mb-2">
                                            Available Points: <strong>@_loyaltyBalance.Points</strong>
                                            (max discount: $@GetMaxDiscount().ToString("F2"))
                                        </p>
                                        <div class="input-group">
                                            <span class="input-group-text">Points to use:</span>
                                            <input type="number"
                                                   class="form-control"
                                                   @bind="_pointsToUse"
                                                   min="0"
                                                   max="@GetMaxPoints()"
                                                   step="100" />
                                            <button class="btn btn-outline-warning" @onclick="UseMaxPoints">Use Max</button>
                                        </div>
                                        @if (_pointsToUse > 0)
                                        {
                                            <div class="mt-2">
                                                <p class="mb-1"><strong>Discount: -$@GetPointsDiscount().ToString("F2")</strong></p>
                                                <p class="mb-0 text-success"><strong>Final Amount: $@GetFinalAmount().ToString("F2")</strong></p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <form>
                                <div class="mb-3">
                                    <label class="form-label">Payment Method</label>
                                    <select class="form-select" @bind="_paymentMethod">
                                        <option value="@PaymentMethod.StripeTest">Stripe Checkout (test)</option>
                                    </select>
                                </div>

                                <div class="d-grid gap-2 mt-4">
                                    <button type="button"
                                            class="btn btn-success btn-lg"
                                            @onclick="ProcessPayment"
                                            disabled="@(!CanProcessPayment() || _isProcessing)">
                                        @if (_isProcessing)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <span class="bi bi-lock-fill"></span>
                                        Pay $@GetFinalAmount().ToString("F2")
                                        @if (_pointsToUse > 0)
                                        {
                                            <small>(Using @_pointsToUse points)</small>
                                        }
                                    </button>

                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="Cancel">
                                        <span class="bi bi-x-circle"></span> Cancel
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>


@code {
    [Parameter]
    public Guid OrderId { get; set; }

    private OrderDto? _order;
    private LoyaltyBalanceDto? _loyaltyBalance;
    private bool _isLoading = true;
    private bool _isProcessing = false;
    private bool _paymentSuccess = false;
    private string? _errorMessage;
    private int _pointsToUse = 0;

    // Form fields
    private string _cardholderName = "";
    private string _cardNumber = "";
    private string _expiryDate = "";
    private string _cvv = "";
    private PaymentMethod _paymentMethod = PaymentMethod.MockCard;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadOrder();
        await LoadLoyaltyBalance();
    }

    private async Task LoadOrder()
    {
        _isLoading = true;

        try
        {
            _order = await OrderService.GetOrderByIdAsync(OrderId);
            
            if (_order == null)
            {
                _errorMessage = "Order not found.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading order: {ex.Message}";
        }

        _isLoading = false;
    }

    private async Task LoadLoyaltyBalance()
    {
        try
        {
            _loyaltyBalance = await LoyaltyService.GetLoyaltyBalanceAsync(AuthService.CurrentUser!.UserId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading loyalty balance: {ex.Message}");
        }
    }

    private decimal GetPointsDiscount()
    {
        return _pointsToUse / 100m;
    }

    private decimal GetFinalAmount()
    {
        if (_order == null) return 0;
        return _order.Price - GetPointsDiscount();
    }

    private decimal GetMaxDiscount()
    {
        if (_loyaltyBalance == null || _order == null) return 0;
        var maxPointsValue = _loyaltyBalance.Points / 100m;
        return Math.Min(maxPointsValue, _order.Price);
    }

    private int GetMaxPoints()
    {
        if (_loyaltyBalance == null || _order == null) return 0;
        var maxPointsForOrder = (int)(_order.Price * 100);
        return Math.Min(_loyaltyBalance.Points, maxPointsForOrder);
    }

    private void UseMaxPoints()
    {
        _pointsToUse = GetMaxPoints();
    }

    private bool CanProcessPayment()
    {
        if (_paymentMethod == PaymentMethod.StripeTest)
            return true; // stripe nu foloseste campurile de card locale
        
        return !string.IsNullOrWhiteSpace(_cardholderName) &&
               !string.IsNullOrWhiteSpace(_cardNumber) &&
               !string.IsNullOrWhiteSpace(_expiryDate) &&
               !string.IsNullOrWhiteSpace(_cvv);
    }

    private async Task ProcessPayment()
    {
        if (_order == null)
        {
            _errorMessage = "Order not found.";
            return;
        }

        _isProcessing = true;
        _errorMessage = null;

        try
        {
            if (_paymentMethod == PaymentMethod.MockCard)
            {
                var request = new CreatePaymentRequest
                {
                    UserId = AuthService.CurrentUser!.UserId,
                    OrderId = OrderId,
                    Amount = _order.Price,
                    Method = PaymentMethod.MockCard,
                    PointsToUse = _pointsToUse > 0 ? _pointsToUse : null
                };

                var response = await PaymentService.CreatePaymentAsync(request);

                if (response.IsSuccessStatusCode)
                {
                    _paymentSuccess = true;
                    await LoadLoyaltyBalance();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    _errorMessage = $"Payment failed: {error}";
                }
            }
            else if (_paymentMethod == PaymentMethod.StripeTest)
            {
                var stripeRequest = new CreateStripeCheckoutSessionRequest
                {
                    UserId = AuthService.CurrentUser!.UserId,
                    OrderId = OrderId,
                    PointsToUse = _pointsToUse > 0 ? _pointsToUse : null
                };

                var checkoutUrl = await PaymentService.CreateStripeCheckoutSessionAsync(stripeRequest);

                if (string.IsNullOrEmpty(checkoutUrl))
                {
                    _errorMessage = "Could not create Stripe checkout session.";
                }
                else
                {
                    Navigation.NavigateTo(checkoutUrl, forceLoad: true);
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error processing payment: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }


    private void GoToOrders()
    {
        Navigation.NavigateTo("/orders");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/orders");
    }
    

}
