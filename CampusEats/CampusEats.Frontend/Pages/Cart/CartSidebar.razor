@using CampusEatsFrontend.Models.Cart
@using CampusEatsFrontend.Models.Order
@using CampusEatsFrontend.Services
@using System.Text.Json
@using System.Text.Json.Serialization
@inject CartService CartService
@inject OrderService OrderService
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="offcanvas offcanvas-end @(_isOpen ? "show" : "")" tabindex="-1" style="visibility: @(_isOpen ? "visible" : "hidden");">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title">
            <i class="bi bi-cart3"></i> Coșul tău
        </h5>
        <button type="button" class="btn-close" @onclick="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        @if (!CartService.Items.Any())
        {
            <div class="text-center text-muted py-5 flex-grow-1 d-flex flex-column justify-content-center">
                <i class="bi bi-cart-x" style="font-size: 4rem;"></i>
                <p class="mt-3 fs-5">Coșul este gol</p>
                <p class="text-muted small">Adaugă produse din meniu</p>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @_errorMessage
                    <button type="button" class="btn-close" @onclick="() => _errorMessage = string.Empty"></button>
                </div>
            }

            <div class="cart-items flex-grow-1" style="overflow-y: auto;">
                @foreach (var item in CartService.Items)
                {
                    <div class="card mb-2 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-start mb-2">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                <div class="flex-grow-1">
                                    <strong class="d-block">@item.Name</strong>
                                    <small class="text-muted">@item.Price?.ToString("F2") RON</small>
                                    @if (item.IsMenuItem)
                                    {
                                        <br />
                                        <small class="badge bg-info">Fel individual</small>
                                    }
                                </div>
                                <button class="btn btn-sm btn-link text-danger p-0" @onclick="async () => await RemoveItem(item)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" @onclick="async () => await UpdateItemQuantity(item, item.Quantity - 1)">
                                        <i class="bi bi-dash"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" disabled style="min-width: 50px;">@item.Quantity</button>
                                    <button class="btn btn-outline-secondary" @onclick="async () => await UpdateItemQuantity(item, item.Quantity + 1)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>
                                <strong class="text-primary">@item.Subtotal.ToString("F2") RON</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="border-top pt-3 mt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-5"><strong>Total:</strong></span>
                    <span class="fs-4 text-primary"><strong>@CartService.TotalPrice.ToString("F2") RON</strong></span>
                </div>
                <button class="btn btn-primary w-100 mb-2" @onclick="PlaceOrderAndCheckout" disabled="@_isPlacingOrder">
                    @if (_isPlacingOrder)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Se plasează comanda...</span>
                    }
                    else
                    {
                        <i class="bi bi-credit-card"></i>
                        <span> Finalizează Comanda</span>
                    }
                </button>
                <button class="btn btn-outline-secondary w-100" @onclick="Close" disabled="@_isPlacingOrder">
                    Continuă Cumpărăturile
                </button>
            </div>
        }
    </div>
</div>

@if (_isOpen)
{
    <div class="offcanvas-backdrop fade show" @onclick="Close"></div>
}

<style>
    .offcanvas {
        width: 420px !important;
        max-width: 90vw;
        transition: transform 0.3s ease-in-out;
        position: fixed;
        top: 0;
        right: 0;
        height: 100vh;
        z-index: 1050;
    }
    
    .offcanvas.show {
        transform: translateX(0) !important;
    }
    
    .offcanvas:not(.show) {
        transform: translateX(100%) !important;
    }
    
    .offcanvas-backdrop {
        background-color: rgba(0, 0, 0, 0.5);
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1040;
    }
</style>

@code {
    private bool _isOpen;
    private bool _isPlacingOrder;
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    public void Open()
    {
        _isOpen = true;
        StateHasChanged();
    }
    
    public void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    private async Task RemoveItem(CartItem item)
    {
        if (item.IsMenuItem && item.MenuItemId.HasValue)
        {
            await CartService.RemoveMenuItemAsync(item.MenuItemId.Value);
        }
        else if (item.MenuId.HasValue)
        {
            await CartService.RemoveItemAsync(item.MenuId.Value);
        }
    }

    private async Task UpdateItemQuantity(CartItem item, int newQuantity)
    {
        if (item.IsMenuItem && item.MenuItemId.HasValue)
        {
            await CartService.UpdateQuantityAsync(item.MenuItemId.Value, newQuantity, true);
        }
        else if (item.MenuId.HasValue)
        {
            await CartService.UpdateQuantityAsync(item.MenuId.Value, newQuantity, false);
        }
    }

    private Task PlaceOrderAndCheckout()
    {
        if (!CartService.Items.Any())
        {
            _errorMessage = "Coșul este gol.";
            return Task.CompletedTask;
        }

        if (AuthService.CurrentUser == null)
        {
            _errorMessage = "Trebuie să fii autentificat pentru a plasa o comandă.";
            return Task.CompletedTask;
        }

        _isPlacingOrder = true;
        _errorMessage = string.Empty;

        try
        {
            // Separăm meniurile de items individuale și le adăugăm de mai multe ori în funcție de cantitate
            var menuIds = new List<Guid>();
            var itemIds = new List<Guid>();
            
            foreach (var cartItem in CartService.Items)
            {
                // Adăugăm ID-ul de mai multe ori pentru a reflecta cantitatea
                for (int i = 0; i < cartItem.Quantity; i++)
                {
                    if (cartItem.IsMenuItem && cartItem.MenuItemId.HasValue)
                    {
                        itemIds.Add(cartItem.MenuItemId.Value);
                    }
                    else if (cartItem.MenuId.HasValue)
                    {
                        menuIds.Add(cartItem.MenuId.Value);
                    }
                }
            }
            
            // Navigate directly to payment page with cart data (no order created yet)
            var menuIdsStr = string.Join(",", menuIds);
            var itemIdsStr = string.Join(",", itemIds);
            
            // Închidem sidebar-ul
            Close();
            
            // Navigate to payment - order will be created after payment success
            Navigation.NavigateTo($"/payment?menus={menuIdsStr}&items={itemIdsStr}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"A apărut o eroare: {ex.Message}";
        }
        finally
        {
            _isPlacingOrder = false;
        }

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
