@page "/kitchen"
@using CampusEatsFrontend.Models.Order
@using CampusEatsFrontend.Services
@inject KitchenService KitchenService
@inject OrderService OrderService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Bucătărie</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4">Bucătărie</h3>

    <div class="row mb-3">
        <div class="col-md-4">
            <select class="form-select" @bind="_statusFilter" @bind:after="LoadOrders">
                <option value="">Toate Comenzile</option>
                <option value="Pending">În așteptare</option>
                <option value="Confirmed">Confirmate</option>
                <option value="Preparing">Se prepară</option>
            </select>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
        </div>
    }
    else if (_orders == null || !_orders.Any())
    {
        <div class="alert alert-info">Nu există comenzi active.</div>
    }
    else
    {
        <div class="row">
            @foreach (var order in _orders.Where(o => o.Status != OrderStatus.Completed && o.Status != OrderStatus.Cancelled))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <!-- Clickable area: header + body opens modal with details -->
                        <div class="card-header badge-primary" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#orderModal-@order.Id" @onclick="() => LoadOrderDetails(order.Id)">
                            <h5 class="mb-0">Comandă #@order.Id.ToString().Substring(0, 8)</h5>
                        </div>
                        <div class="card-body" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#orderModal-@order.Id" @onclick="() => LoadOrderDetails(order.Id)">
                            <p class="mb-2"><strong>Status:</strong> <span class="badge badge-primary">@order.Status</span></p>
                            <p class="mb-2"><strong>Plasată la:</strong> @order.CreatedAt.ToString("HH:mm")</p>
                            <p class="mb-2"><strong>Preț:</strong> @order.Price.ToString("F2") RON</p>
                            <p class="mb-2"><strong>Conținut:</strong> @order.MenuIDs.Count meniuri, @order.ItemIDs.Count feluri individuale</p>
                        </div>
                        <!-- Non-clickable controls: footer with status buttons -->
                        <div class="card-footer bg-transparent border-top">
                            <div class="d-grid gap-2">
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <button class="btn btn-primary btn-sm" @onclick="() => UpdateStatus(order.Id, OrderStatus.Confirmed)">
                                        Confirmă Comanda
                                    </button>
                                }
                                @if (order.Status == OrderStatus.Confirmed)
                                {
                                    <button class="btn btn-warning btn-sm" @onclick="() => UpdateStatus(order.Id, OrderStatus.Preparing)">
                                        Începe Prepararea
                                    </button>
                                }
                                @if (order.Status == OrderStatus.Preparing)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => UpdateStatus(order.Id, OrderStatus.Completed)">
                                        Marchează Completat
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <!-- Modal for Order Details -->
                    <div class="modal fade" id="orderModal-@order.Id" tabindex="-1" aria-labelledby="orderModalLabel-@order.Id" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <div class="modal-header badge-primary">
                                    <h5 class="modal-title" id="orderModalLabel-@order.Id">Order Details #@order.Id.ToString().Substring(0, 8)</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    @if (_loadingDetails.Contains(order.Id))
                                    {
                                        <div class="text-center">
                                            <div class="spinner-border" role="status">
                                                <span class="visually-hidden">Se încarcă detaliile...</span>
                                            </div>
                                        </div>
                                    }
                                    else if (_orderDetails.ContainsKey(order.Id))
                                    {
                                        var details = _orderDetails[order.Id];
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <h6>Informații Client</h6>
                                                <p class="mb-1"><strong>Nume:</strong> @details.ClientUsername</p>
                                                <p class="mb-1"><strong>Email:</strong> @details.ClientEmail</p>
                                            </div>
                                            <div class="col-md-6">
                                                <h6>Informații Comandă</h6>
                                                <p class="mb-1"><strong>Total:</strong> @details.Price.ToString("F2") RON</p>
                                                <p class="mb-1"><strong>Status:</strong> <span class="badge badge-primary">@details.Status</span></p>
                                                <p class="mb-1"><strong>Plasată la:</strong> @details.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                            </div>
                                        </div>
                                        
                                        <hr />
                                        
                                        <div class="row">
                                            @if (details.Menus.Any())
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <h6>Meniuri (@details.Menus.Count)</h6>
                                                    <ul class="list-group">
                                                        @foreach (var menu in details.Menus)
                                                        {
                                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                @menu.Name
                                                                <span class="badge bg-primary rounded-pill">@menu.Price.ToString("F2") RON</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            @if (details.Items.Any())
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <h6>Feluri individuale (@details.Items.Count)</h6>
                                                    <ul class="list-group">
                                                        @foreach (var item in details.Items)
                                                        {
                                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                @item.Name
                                                                <span class="badge bg-success rounded-pill">@item.Price.ToString("F2") RON</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Închide</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<OrderDto>? _orders;
    private readonly Dictionary<Guid, OrderDetailsDto> _orderDetails = new();
    private readonly HashSet<Guid> _loadingDetails = new();
    private string _statusFilter = "";
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        var userRole = AuthService.CurrentUser?.Role;
        if (userRole != "Kitchen" && userRole != "Admin")
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        _isLoading = true;
        _orders = await KitchenService.GetKitchenOrdersAsync(string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter);
        _isLoading = false;
    }

    private async Task LoadOrderDetails(Guid orderId)
    {
        if (_orderDetails.ContainsKey(orderId))
            return;

        _loadingDetails.Add(orderId);
        StateHasChanged();

        try
        {
            var details = await OrderService.GetOrderDetailsAsync(orderId);
            if (details != null)
            {
                _orderDetails[orderId] = details;
            }
        }
        finally
        {
            _loadingDetails.Remove(orderId);
            StateHasChanged();
        }
    }

    private async Task UpdateStatus(Guid orderId, OrderStatus newStatus)
    {
        var response = await KitchenService.UpdateOrderStatusAsync(orderId, newStatus);
        if (response.IsSuccessStatusCode)
        {
            // Remove from cache to reload fresh data
            _orderDetails.Remove(orderId);
            await LoadOrders();
        }
    }
}
