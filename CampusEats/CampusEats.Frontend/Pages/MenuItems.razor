@page "/menu-items"
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject MenuItemService MenuItemService
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Menu Items - CampusEats</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Menu Items (Products)</h3>
        @if (AuthService.CurrentUser?.Role == "Admin")
        {
            <button class="btn btn-primary" @onclick="GoToCreate">
                <span class="bi bi-plus-circle"></span> Add Menu Item
            </button>
        }
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Search by name..." @bind="_searchTerm" @bind:event="oninput" @onkeyup="FilterItems" />
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_filteredItems == null || _filteredItems.Count == 0)
    {
        <div class="alert alert-info">No menu items found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Image</th>
                        <th>Allergens</th>
                        @if (AuthService.CurrentUser?.Role == "Admin")
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _filteredItems)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>$@item.Price.ToString("F2")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">No image</span>
                                }
                            </td>
                            <td>
                                @if (item.Allergens != null && item.Allergens.Any())
                                {
                                    <span>@string.Join(", ", item.Allergens)</span>
                                }
                                else
                                {
                                    <span class="text-muted">None</span>
                                }
                            </td>
                            @if (AuthService.CurrentUser?.Role == "Admin")
                            {
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => GoToEdit(item.Id)">
                                        <span class="bi bi-pencil"></span> Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteMenuItem(item.Id)">
                                        <span class="bi bi-trash"></span> Delete
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<MenuItemDto>? _allItems;
    private List<MenuItemDto>? _filteredItems;
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await LoadItems();
    }

    private async Task LoadItems()
    {
        _isLoading = true;
        _allItems = await MenuItemService.GetAllMenuItemsAsync();
        _filteredItems = _allItems;
        _isLoading = false;
    }

    private void FilterItems()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredItems = _allItems;
        }
        else
        {
            _filteredItems = _allItems?
                .Where(i => i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void GoToCreate()
    {
        Navigation.NavigateTo("/menu-items/create");
    }

    private void GoToEdit(Guid id)
    {
        Navigation.NavigateTo($"/menu-items/edit/{id}");
    }

    private async Task DeleteMenuItem(Guid id)
    {
        if (confirm($"Are you sure you want to delete this menu item?"))
        {
            var response = await MenuItemService.DeleteMenuItemAsync(id);
            if (response.IsSuccessStatusCode)
            {
                await LoadItems();
                StateHasChanged();
            }
        }
    }

    private bool confirm(string message) => true; // Browser confirmation would be handled differently
}
