@page "/menu-items/edit/{id:guid}"
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject MenuItemService MenuItemService
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Modifică felul de mâncare</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title mb-4">Modifică felul de mâncare</h3>

                    @if (_isLoadingItem)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Se încarcă...</span>
                            </div>
                        </div>
                    }
                    else if (_updateRequest == null)
                    {
                        <div class="alert alert-danger">Felul de mîncare nu a fost găsit</div>
                        <button class="btn btn-primary" @onclick="Cancel">Anulează</button>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_errorMessage
                            </div>
                        }

                        <EditForm Model="@_updateRequest" OnValidSubmit="@HandleUpdate">
                            <div class="mb-3">
                                <label for="name" class="form-label">Nume <span class="text-danger">*</span></label>
                                <InputText id="name" class="form-control" @bind-Value="_updateRequest.Name" placeholder="e.g., Cheeseburger" />
                            </div>

                            <div class="mb-3">
                                <label for="price" class="form-label">Preț (RON) <span class="text-danger">*</span></label>
                                <InputNumber id="price" class="form-control" @bind-Value="_updateRequest.Price" step="0.01" />
                            </div>

                            <div class="mb-3">
                                <label for="imageUrl" class="form-label">URL Imagine</label>
                                <InputText id="imageUrl" class="form-control" @bind-Value="_updateRequest.ImageUrl" placeholder="https://example.com/image.jpg" />
                                @if (!string.IsNullOrEmpty(_updateRequest.ImageUrl))
                                {
                                    <div class="mt-2">
                                        <img src="@_updateRequest.ImageUrl" alt="Preview" style="max-width: 200px; max-height: 200px;" class="img-thumbnail" />
                                    </div>
                                }
                            </div>

                            <div class="mb-3">
                                <label for="allergens" class="form-label">Alergeni</label>
                                <div class="border p-3 rounded allergens-box">
                                    @foreach (var allergen in _availableAllergens)
                                    {
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   id="@allergen" 
                                                   checked="@(_selectedAllergens.Contains(allergen))"
                                                   @onchange="() => ToggleAllergen(allergen)" />
                                            <label class="form-check-label" for="@allergen">
                                                @allergen
                                            </label>
                                        </div>
                                    }
                                </div>
                                <small class="form-text text-muted">Selectați alergenii aplicați.</small>
    
                                @if (!_selectedAllergens.Any())
                                {
                                    <p class="text-success mt-2">Niciun alergen selectat.</p>
                                }
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-outline-light" @onclick="Cancel">Anulează</button>
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @if (_isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Se salvează modificările...</span>
                                    }
                                    else
                                    {
                                        <span>Salvează modificările</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UpdateMenuItemRequest _updateRequest = new();
    
    private string _errorMessage = string.Empty;
    private bool _isLoadingItem = true;
    private bool _isSaving = false;

    private readonly List<string> _availableAllergens =
    [
        "Lapte", "Lactoză", "Brânzeturi", "Ouă", 
        "Gluten", "Grâu", 
        "Nuci", "Arahide", "Migdale", "Cashew", 
        "Pește", "Moluște", "Crustacee",
        "Citrice", "Soya"
    ];
    
    private readonly List<string> _selectedAllergens = [];
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        if (AuthService.CurrentUser?.Role != "Admin")
        {
            Navigation.NavigateTo("/menu-items");
            return;
        }

        await LoadMenuItem();
    }

    private async Task LoadMenuItem()
    {
        _isLoadingItem = true;
        var item = await MenuItemService.GetMenuItemByIdAsync(Id);
        
        if (item != null)
        {
            _updateRequest = new UpdateMenuItemRequest
            {
                Id = item.Id,
                Name = item.Name,
                Price = item.Price,
                ImageUrl = item.ImageUrl,
                Allergens = item.Allergens
            };
            
           _selectedAllergens.Clear();
            if (item.Allergens != null)
            {
                _selectedAllergens.AddRange(item.Allergens);
            }
        }

        _isLoadingItem = false;
    }

    private async Task HandleUpdate()
    {
        _isSaving = true;
        _errorMessage = string.Empty;

        try
        {
            // Validate
            if (string.IsNullOrWhiteSpace(_updateRequest.Name))
            {
                _errorMessage = "Numele este obligatoriu.";
                _isSaving = false;
                return;
            }

            if (_updateRequest.Price <= 0)
            {
                _errorMessage = "Prețul trebuie să fie mai mare decât 0.";
                _isSaving = false;
                return;
            }
            _updateRequest.Allergens = _selectedAllergens.ToList();
            
            var response = await MenuItemService.UpdateMenuItemAsync(_updateRequest);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/menu-items");
            }
            else
            {
                _errorMessage = "Eroare la modificare. Încreacă din nou.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"A intervenit o eroare: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
    
    private void ToggleAllergen(string allergen)
    {
        if (_selectedAllergens.Contains(allergen))
        {
            _selectedAllergens.Remove(allergen);
        }
        else
        {
            _selectedAllergens.Add(allergen);
        }
        StateHasChanged();
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/menu-items");
    }
}
