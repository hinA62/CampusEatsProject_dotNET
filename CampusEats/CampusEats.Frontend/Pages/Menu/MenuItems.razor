@page "/menu-items"
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject MenuItemService MenuItemService
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Menu Items - CampusEats</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Menu Items</h3>
        @if (AuthService.CurrentUser?.Role == "Admin")
        {
            <button class="btn btn-primary" @onclick="GoToCreate">
                <span class="bi bi-plus-circle"></span> Adaugă Menu Item
            </button>
        }
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Caută după nume..." @bind="_searchTerm" @bind:event="oninput" @onkeyup="FilterItems" />
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
        </div>
    }
    else if (_filteredItems == null || _filteredItems.Count == 0)
    {
        <div class="alert alert-info">Nu au fost găsite articole de meniu.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in _filteredItems)
            {
                <div class="col-sm-6 col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top item-image" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="card-img-top item-image d-flex align-items-center justify-content-center bg-light text-muted">
                                Fără imagine
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-success fw-bold flex-grow-1">@item.Price.ToString("F2") RON</p>
                            
                            <div class="allergens">
                                <small class="text-allergens">Alergeni:</small><br />
                                @if (item.Allergens != null && item.Allergens.Any())
                                {
                                    <span class="badge bg-warning text-dark allergens-badge">@string.Join(", ", item.Allergens)</span>
                                }
                                else
                                {
                                    <span class="text-muted">Niciunul</span>
                                }
                            </div>
                        </div>

                        @if (AuthService.CurrentUser?.Role == "Admin")
                        {
                            <div class="card-footer d-flex justify-content-between">
                                <button class="btn btn-sm flex-grow-1 me-2 btn-outline-secondary" @onclick="() => GoToEdit(item.Id)">
                                    <span class="bi bi-pencil"></span> Modifică
                                </button>
                                <button class="btn btn-sm btn-danger flex-grow-1 btn-delete" @onclick="() => DeleteMenuItem(item.Id)">
                                    <span class="bi bi-trash"></span> Șterge
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<MenuItemDto>? _allItems;
    private List<MenuItemDto>? _filteredItems;
    private string _searchTerm = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await LoadItems();
    }

    private async Task LoadItems()
    {
        _isLoading = true;
        _allItems = await MenuItemService.GetAllMenuItemsAsync();
        _filteredItems = _allItems;
        _isLoading = false;
        StateHasChanged();
    }

    private void FilterItems()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredItems = _allItems;
        }
        else
        {
            // Utilizare Contains pe Name pentru filtrare
            _filteredItems = _allItems?
                .Where(i => i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void GoToCreate()
    {
        Navigation.NavigateTo("/menu-items/create");
    }

    private void GoToEdit(Guid id)
    {
        Navigation.NavigateTo($"/menu-items/edit/{id}");
    }

    private async Task DeleteMenuItem(Guid id)
    {
        if (Confirm($"Sunteți sigur că doriți să ștergeți acest articol de meniu?"))
        {
            try
            {
                var response = await MenuItemService.DeleteMenuItemAsync(id);
                if (response.IsSuccessStatusCode)
                {
                    await LoadItems(); 
                }
                else
                {
                    Console.WriteLine($"Eroare la ștergere: {response.ReasonPhrase}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Excepție la ștergere: {ex.Message}");
            }
        }
    }

    private static bool Confirm(string message) => true; 
}