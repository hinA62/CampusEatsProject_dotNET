@page "/menu-items"
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject MenuItemService MenuItemService
@inject CartService CartService
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Menu Items - CampusEats</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Menu Items</h3>
        @if (AuthService.CurrentUser?.Role == "Admin")
        {
            <button class="btn btn-primary" @onclick="GoToCreate">
                <span class="bi bi-plus-circle"></span> Adaugă Menu Item
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = string.Empty"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Caută după nume..." @bind="_searchTerm" @bind:event="oninput" @onkeyup="FilterItems" />
        </div>
        <div class="col-md-4">
            <div class="dropdown">
                <button class="form-select text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Restricții alimentare
                </button>
                <ul class="dropdown-menu p-2" style="min-width: 250px;">
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkLactose" @bind="_filterNoLactose" @bind:after="FilterItems" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkLactose">Fără lactoză</label>
                        </div>
                    </li>
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkGluten" @bind="_filterNoGluten" @bind:after="FilterItems" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkGluten">Fără gluten</label>
                        </div>
                    </li>
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkNuts" @bind="_filterNoNuts" @bind:after="FilterItems" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkNuts">Fără nuci</label>
                        </div>
                    </li>
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkDairy" @bind="_filterNoDairy" @bind:after="FilterItems" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkDairy">Fără lactate</label>
                        </div>
                    </li>
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkSeafood" @bind="_filterNoSeafood" @bind:after="FilterItems" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkSeafood">Fără fructe de mare</label>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
        </div>
    }
    else if (_filteredItems == null || _filteredItems.Count == 0)
    {
        <div class="alert alert-info">Nu au fost găsite articole de meniu.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in _filteredItems)
            {
                <div class="col-sm-6 col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top item-image" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="card-img-top item-image d-flex align-items-center justify-content-center bg-light text-muted">
                                Fără imagine
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-success fw-bold">@item.Price.ToString("F2") RON</p>
                            
                            <div class="allergens mb-3 flex-grow-1">
                                <small class="text-allergens">Alergeni:</small><br />
                                @if (item.Allergens != null && item.Allergens.Any())
                                {
                                    @foreach (var allergen in item.Allergens)
                                    {
                                        <span class="badge bg-warning text-dark allergens-badge me-1">@allergen</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Niciunul</span>
                                }
                            </div>

                            @* Add to Cart Button - visible for all authenticated users - anchored to bottom *@
                            @if (AuthService.IsAuthenticated && item.Price > 0)
                            {
                                <button class="btn btn-success w-100 mb-2 mt-auto" @onclick="async () => await AddToCart(item)">
                                    <i class="bi bi-cart-plus"></i> Adaugă în coș
                                </button>
                            }
                        </div>

                        @if (AuthService.CurrentUser?.Role == "Admin")
                        {
                            <div class="card-footer d-flex justify-content-between">
                                <button class="btn btn-sm flex-grow-1 me-2 btn-outline-secondary" @onclick="() => GoToEdit(item.Id)">
                                    <span class="bi bi-pencil"></span> Modifică
                                </button>
                                <button class="btn btn-sm btn-danger flex-grow-1 btn-delete" @onclick="() => DeleteMenuItem(item.Id)">
                                    <span class="bi bi-trash"></span> Șterge
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<MenuItemDto>? _allItems;
    private List<MenuItemDto>? _filteredItems;
    private string _searchTerm = string.Empty;
    private bool _filterNoLactose = false;
    private bool _filterNoGluten = false;
    private bool _filterNoNuts = false;
    private bool _filterNoDairy = false;
    private bool _filterNoSeafood = false;
    private string _successMessage = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await CartService.InitializeAsync();
        await LoadItems();
    }

    private async Task LoadItems()
    {
        _isLoading = true;
        _allItems = await MenuItemService.GetAllMenuItemsAsync();
        _filteredItems = _allItems;
        _isLoading = false;
        StateHasChanged();
    }

    private void FilterItems()
    {
        _filteredItems = _allItems;

        // Filter by search term
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredItems = _filteredItems?
                .Where(i => i.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        // Filter by multiple allergens (items WITHOUT the selected allergens)
        if (_filterNoLactose)
        {
            _filteredItems = _filteredItems?.Where(i => i.Allergens == null || !i.Allergens.Any(a => a.Contains("lapte", StringComparison.OrdinalIgnoreCase) || a.Contains("lactoză", StringComparison.OrdinalIgnoreCase))).ToList();
        }
        if (_filterNoGluten)
        {
            _filteredItems = _filteredItems?.Where(i => i.Allergens == null || !i.Allergens.Any(a => a.Contains("gluten", StringComparison.OrdinalIgnoreCase))).ToList();
        }
        if (_filterNoNuts)
        {
            _filteredItems = _filteredItems?.Where(i => i.Allergens == null || !i.Allergens.Any(a => a.Contains("nuci", StringComparison.OrdinalIgnoreCase) || a.Contains("alune", StringComparison.OrdinalIgnoreCase))).ToList();
        }
        if (_filterNoDairy)
        {
            _filteredItems = _filteredItems?.Where(i => i.Allergens == null || !i.Allergens.Any(a => a.Contains("lactate", StringComparison.OrdinalIgnoreCase) || a.Contains("lapte", StringComparison.OrdinalIgnoreCase))).ToList();
        }
        if (_filterNoSeafood)
        {
            _filteredItems = _filteredItems?.Where(i => i.Allergens == null || !i.Allergens.Any(a => a.Contains("pește", StringComparison.OrdinalIgnoreCase) || a.Contains("fructe de mare", StringComparison.OrdinalIgnoreCase))).ToList();
        }
    }

    private void GoToCreate()
    {
        Navigation.NavigateTo("/menu-items/create");
    }

    private void GoToEdit(Guid id)
    {
        Navigation.NavigateTo($"/menu-items/edit/{id}");
    }

    private async Task DeleteMenuItem(Guid id)
    {
        if (Confirm($"Sunteți sigur că doriți să ștergeți acest articol de meniu?"))
        {
            try
            {
                var response = await MenuItemService.DeleteMenuItemAsync(id);
                if (response.IsSuccessStatusCode)
                {
                    await LoadItems(); 
                }
                else
                {
                    Console.WriteLine($"Eroare la ștergere: {response.ReasonPhrase}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Excepție la ștergere: {ex.Message}");
            }
        }
    }

    private async Task AddToCart(MenuItemDto item)
    {
        await CartService.AddMenuItemAsync(item);
        _successMessage = $"✓ {item.Name} a fost adăugat în coș!";
        
        // Clear success message after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            _successMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        });
    }

    private static bool Confirm(string message) => true; 
}