@page "/menus/edit/{id:guid}"
@using CampusEatsFrontend.Models.Menu
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject NavigationManager Navigation
@inject MenuService MenuService
@inject MenuItemService MenuItemService
@inject AuthService AuthService

<PageTitle>Modifică Meniu</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title mb-4">Modifică un Meniu</h3>

                    @if (_isLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Se încarcă...</span>
                            </div>
                        </div>
                    }
                    else if (_updateRequest == null)
                    {
                        <div class="alert alert-danger">Meniul nu a fost găsit.</div>
                        <button class="btn btn-primary" @onclick="Cancel">Înapoi</button>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_errorMessage
                            </div>
                        }

                        <EditForm Model="_updateRequest" OnValidSubmit="Save">
                            <div class="mb-3">
                                <label class="form-label">Nume <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_updateRequest.Name" placeholder="e.g., Breakfast Menu" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Categorie <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_updateRequest.Category">
                                    @foreach (var cat in Enum.GetValues<MenuCategory>())
                                    {
                                        <option value="@cat">@cat</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> <strong>Restricțiile alimentare</strong> se calculează automat din alergenii felurilor selectate.
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Preț (RON)</label>
                                <InputNumber class="form-control" @bind-Value="_updateRequest.Price" step="0.01" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">URL Imagine</label>
                                <InputText class="form-control" @bind-Value="_updateRequest.ImageUrl" placeholder="https://example.com/image.jpg" />
                                <small class="form-text text-muted">Opțional</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Selectează feluri de mâncare</label>
                                @if (_availableMenuItems == null || !_availableMenuItems.Any())
                                {
                                    <div class="alert alert-warning">
                                        Nu există feluri disponibile. <a href="/menu-items/create">Adaugă un fel de mâncare</a> mai întâi.
                                    </div>
                                }
                                else
                                {
                                    <div class="border rounded p-3" style="max-height: 300px; overflow-y: auto;">
                                        @foreach (var item in _availableMenuItems)
                                        {
                                            var isSelected = _selectedItemIds.Contains(item.Id);
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" 
                                                       id="item-@item.Id" 
                                                       checked="@isSelected"
                                                       @onchange="@((ChangeEventArgs e) => ToggleMenuItem(item.Id, (bool)e.Value!))" />
                                                <label class="form-check-label" for="item-@item.Id">
                                                    <strong>@item.Name</strong> - @item.Price.ToString("F2") RON
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    <small class="form-text text-muted">Selected: @_selectedItemIds.Count item(s)</small>
                                }
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Anulează</button>
                                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                                    @if (_isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Se salvează...</span>
                                    }
                                    else
                                    {
                                        <span>Salvează Modificările</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UpdateMenuRequest? _updateRequest;
    private List<MenuItemDto>? _availableMenuItems;
    private HashSet<Guid> _selectedItemIds = new();
    private string _errorMessage = string.Empty;
    private bool _isLoading = true;
    private bool _isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        if (AuthService.CurrentUser?.Role != "Admin")
        {
            Navigation.NavigateTo("/menus");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        
        var menuTask = MenuService.GetMenuByIdAsync(Id);
        var itemsTask = MenuItemService.GetAllMenuItemsAsync();
        
        await Task.WhenAll(menuTask, itemsTask);
        
        var menu = await menuTask;
        _availableMenuItems = await itemsTask;

        if (menu != null)
        {
            _updateRequest = new UpdateMenuRequest
            {
                Id = menu.Id,
                Name = menu.Name,
                Category = menu.Category,
                Price = menu.Price,
                ItemIds = menu.ItemIds
            };

            _selectedItemIds = new HashSet<Guid>(menu.ItemIds);
        }

        _isLoading = false;
    }

    private void ToggleMenuItem(Guid itemId, bool isChecked)
    {
        if (isChecked)
        {
            _selectedItemIds.Add(itemId);
        }
        else
        {
            _selectedItemIds.Remove(itemId);
        }
        StateHasChanged();
    }

    async Task Save()
    {
        if (_updateRequest == null) return;

        _isSaving = true;
        _errorMessage = string.Empty;

        try
        {
            if (string.IsNullOrWhiteSpace(_updateRequest.Name))
            {
                _errorMessage = "Menu name is required.";
                _isSaving = false;
                return;
            }

            _updateRequest.ItemIds = _selectedItemIds.ToList();

            var response = await MenuService.UpdateMenuAsync(_updateRequest);
            
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/menus");
            }
            else
            {
                _errorMessage = "Failed to update menu. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/menus");
    }
}
