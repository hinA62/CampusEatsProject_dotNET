@page "/menus"
@inject MenuService MenuService
@inject MenuItemService MenuItemService
@inject CartService CartService
@using CampusEatsFrontend.Models.Menu
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Meniuri</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Meniuri (Colecții)</h3>
        @if (AuthService.CurrentUser?.Role == "Admin")
        {
            <button class="btn btn-primary" @onclick="GoToCreate">
                <span class="bi bi-plus-circle"></span> Adaugă Meniu
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = string.Empty"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" class="form-control" placeholder="Caută după nume..." @bind="_searchTerm" @bind:event="oninput" @bind:after="FilterMenus" />
        </div>
        <div class="col-md-3">
            <div class="dropdown">
                <button class="form-select text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @(_selectedCategory == "" ? "Toate categoriile" : _selectedCategory)
                </button>
                <ul class="dropdown-menu" style="min-width: 250px;">
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="categoryRadio" id="radioAllCategories" 
                                   checked="@(_selectedCategory == string.Empty)" 
                                   @onchange="@(() => SelectCategory(string.Empty))" 
                                   @onclick:stopPropagation="true">
                            <label class="form-check-label" for="radioAllCategories">Toate categoriile</label>
                        </div>
                    </li>
                    @foreach (var category in Enum.GetValues<MenuCategory>())
                    {
                        var categoryStr = category.ToString();
                        var radioId = $"radio{categoryStr}";
                        <li class="px-2 py-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="categoryRadio" id="@radioId" 
                                       checked="@(_selectedCategory == categoryStr)" 
                                       @onchange="@(() => SelectCategory(categoryStr))" 
                                       @onclick:stopPropagation="true">
                                <label class="form-check-label" for="@radioId">@categoryStr</label>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-md-3">
            <div class="dropdown">
                <button class="form-select text-start dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Restricții alimentare
                </button>
                <ul class="dropdown-menu p-2" style="min-width: 250px;">
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkLactoseFree" @bind="_filterLactoseFree" @bind:after="FilterMenus" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkLactoseFree">Fără lactoză</label>
                        </div>
                    </li>
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkGlutenFree" @bind="_filterGlutenFree" @bind:after="FilterMenus" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkGlutenFree">Fără gluten</label>
                        </div>
                    </li>
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkNutFree" @bind="_filterNutFree" @bind:after="FilterMenus" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkNutFree">Fără nuci</label>
                        </div>
                    </li>
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkDairyFree" @bind="_filterDairyFree" @bind:after="FilterMenus" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkDairyFree">Fără lactate</label>
                        </div>
                    </li>
                    <li class="px-2 py-1">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="checkNoSeafoodMenu" @bind="_filterNoSeafood" @bind:after="FilterMenus" @onclick:stopPropagation="true">
                            <label class="form-check-label" for="checkNoSeafoodMenu">Fără fructe de mare</label>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    @if (_menus == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
        </div>
    }
    else if (_filteredMenus == null || _filteredMenus.Count == 0)
    {
        <div class="alert alert-info">Nu s-au găsit meniuri pentru filtrele selectate.</div>
    }
    else
    {
        <div class="row">
            @foreach (var menu in _filteredMenus)
            {
                <div class="col-sm-6 col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(menu.ImageUrl))
                        {
                            <img src="@menu.ImageUrl" class="card-img-top item-image" alt="@menu.Name" />
                        }
                        else
                        {
                            <div class="card-img-top item-image d-flex align-items-center justify-content-center bg-light text-muted">
                                Fără imagine
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@menu.Name</h5>
                            <p class="card-text">
                                <strong>Preț:</strong> @(menu.Price.HasValue ? $"{menu.Price.Value:F2} RON" : "N/A")
                            </p>
                            <p class="card-text flex-grow-1">
                                <span class="badge bg-info me-2 badge-primary">@menu.Category</span>
                                @foreach (var restriction in GetRestrictionsList(menu.Restrictions))
                                {
                                    <span class="badge bg-warning me-1 allergens-badge">@restriction</span>
                                }
                            </p>
                            
                            @* Add to Cart Button - visible for all authenticated users - anchored to bottom *@
                            @if (AuthService.IsAuthenticated && menu.Price.HasValue && menu.Price.Value > 0)
                            {
                                <button class="btn btn-success w-100 mb-2 mt-auto" @onclick="async () => await AddToCart(menu)">
                                    <i class="bi bi-cart-plus"></i> Adaugă în coș
                                </button>
                            }
                            
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-secondary w-100" @onclick="() => ToggleMenuItems(menu.Id)">
                                    <span class="bi @(_expandedMenus.Contains(menu.Id) ? "bi-chevron-up" : "bi-chevron-down") btn-outline-secondary"></span>
                                    @(_expandedMenus.Contains(menu.Id) ? "Ascunde" : "Arată") Articole (@menu.ItemIds.Count)
                                </button>
                            </div>
                            
                            @if (_expandedMenus.Contains(menu.Id))
                            {
                                <div class="mt-3">  
                                    @if (_menuItemsCache.ContainsKey(menu.Id))
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var item in _menuItemsCache[menu.Id])
                                            {
                                                <li class="list-group-item px-0 py-2">
                                                    <small>
                                                        <strong>@item.Name</strong><br />
                                                        <span class="text-muted">@item.Price.ToString("F2") RON</span>
                                                    </small>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <div class="text-center py-2">
                                            <div class="spinner-border spinner-border-sm" role="status">
                                                <span class="visually-hidden">Se încarcă...</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (AuthService.CurrentUser?.Role == "Admin")
                        {
                            <div class="card-footer bg-transparent border-top-0">
                                <div class="d-flex justify-content-between">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToEdit(menu.Id)">
                                        <span class="bi bi-pencil"></span> Modifică
                                    </button>
                                    <button class="btn btn-sm btn-delete" @onclick="() => DeleteMenu(menu.Id)">
                                        <span class="bi bi-trash"></span> Șterge
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    List<MenuDto>? _menus;
    List<MenuDto>? _filteredMenus;
    HashSet<Guid> _expandedMenus = new();
    Dictionary<Guid, List<MenuItemDto>> _menuItemsCache = new();
    List<MenuItemDto>? _allMenuItems;
    string _successMessage = string.Empty;
    string _searchTerm = string.Empty;
    string _selectedCategory = string.Empty;
    bool _filterLactoseFree = false;
    bool _filterGlutenFree = false;
    bool _filterNutFree = false;
    bool _filterDairyFree = false;
    bool _filterNoSeafood = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await CartService.InitializeAsync();
        await LoadMenus();
        _allMenuItems = await MenuItemService.GetAllMenuItemsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadMenus();
    }

    private async Task LoadMenus()
    {
        _menus = await MenuService.GetAllMenusAsync();
        _filteredMenus = _menus;
    }

    private void SelectCategory(string category)
    {
        _selectedCategory = category;
        FilterMenus();
    }

    private void FilterMenus()
    {
        _filteredMenus = _menus;

        // Filter by search term
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredMenus = _filteredMenus?
                .Where(m => m.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        // Filter by category
        if (!string.IsNullOrWhiteSpace(_selectedCategory) && Enum.TryParse<MenuCategory>(_selectedCategory, out var category))
        {
            _filteredMenus = _filteredMenus?.Where(m => m.Category == category).ToList();
        }

        // Filter by multiple dietary restrictions (menus WITH the selected restrictions)
        if (_filterLactoseFree)
        {
            _filteredMenus = _filteredMenus?.Where(m => m.Restrictions.HasFlag(DietaryRestrictions.LactoseFree)).ToList();
        }
        if (_filterGlutenFree)
        {
            _filteredMenus = _filteredMenus?.Where(m => m.Restrictions.HasFlag(DietaryRestrictions.GlutenFree)).ToList();
        }
        if (_filterNutFree)
        {
            _filteredMenus = _filteredMenus?.Where(m => m.Restrictions.HasFlag(DietaryRestrictions.NutFree)).ToList();
        }
        if (_filterDairyFree)
        {
            _filteredMenus = _filteredMenus?.Where(m => m.Restrictions.HasFlag(DietaryRestrictions.DairyFree)).ToList();
        }
        if (_filterNoSeafood)
        {
            _filteredMenus = _filteredMenus?.Where(m => m.Restrictions.HasFlag(DietaryRestrictions.NoSeafood)).ToList();
        }
    }

    void GoToCreate()
    {
        Navigation.NavigateTo("/menus/create");
    }

    void GoToEdit(Guid id)
    {
        Navigation.NavigateTo($"/menus/edit/{id}");
    }

    private async Task DeleteMenu(Guid id)
    {
        var response = await MenuService.DeleteMenuAsync(id);
        if (response.IsSuccessStatusCode)
        {
            _menus = await MenuService.GetAllMenusAsync();
            StateHasChanged();
        }
    }

    private void ToggleMenuItems(Guid menuId)
    {
        if (_expandedMenus.Contains(menuId))
        {
            _expandedMenus.Remove(menuId);
        }
        else
        {
            _expandedMenus.Add(menuId);
            
            // Load menu items if not already cached
            if (!_menuItemsCache.ContainsKey(menuId) && _allMenuItems != null)
            {
                var menu = _menus?.FirstOrDefault(m => m.Id == menuId);
                if (menu != null)
                {
                    _menuItemsCache[menuId] = _allMenuItems
                        .Where(item => menu.ItemIds.Contains(item.Id))
                        .ToList();
                }
            }
        }
    }

    private async Task AddToCart(MenuDto menu)
    {
        await CartService.AddItemAsync(menu);
        _successMessage = $"✓ {menu.Name} a fost adăugat în coș!";
        
        // Clear success message after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            _successMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        });
    }

    private List<string> GetRestrictionsList(DietaryRestrictions restrictions)
    {
        var list = new List<string>();
    
        // Verifică fiecare flag
        if (restrictions.HasFlag(DietaryRestrictions.LactoseFree))
            list.Add("Fără Lactoză");
        if (restrictions.HasFlag(DietaryRestrictions.GlutenFree))
            list.Add("Fără Gluten");
        if (restrictions.HasFlag(DietaryRestrictions.NutFree))
            list.Add("Fără Nuci");
        if (restrictions.HasFlag(DietaryRestrictions.DairyFree))
            list.Add("Fără Lactate");
        if (restrictions.HasFlag(DietaryRestrictions.NoSeafood))
            list.Add("Fără Fructe de Mare");
        if (restrictions.HasFlag(DietaryRestrictions.FoodAllergyFriendly))
            list.Add("Fără alergeni suplimentari");
        
        return list.Count == 0 ? ["Poate provoca alergii!"] : list;
    }
}
