@page "/menus"
@inject MenuService MenuService
@inject MenuItemService MenuItemService
@inject CartService CartService
@using CampusEatsFrontend.Models.Menu
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Meniuri</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Meniuri (Colecții)</h3>
        @if (AuthService.CurrentUser?.Role == "Admin")
        {
            <button class="btn btn-primary" @onclick="GoToCreate">
                <span class="bi bi-plus-circle"></span> Adaugă Meniu
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @_successMessage
            <button type="button" class="btn-close" @onclick="() => _successMessage = string.Empty"></button>
        </div>
    }

    @if (_menus == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
        </div>
    }
    else if (_menus.Count == 0)
    {
        <div class="alert alert-info">Momentan, nu există meniuri.</div>
    }
    else
    {
        <div class="row">
            @foreach (var menu in _menus)
            {
                <div class="col-sm-6 col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(menu.ImageUrl))
                        {
                            <img src="@menu.ImageUrl" class="card-img-top item-image" alt="@menu.Name" />
                        }
                        else
                        {
                            <div class="card-img-top item-image d-flex align-items-center justify-content-center bg-light text-muted">
                                Fără imagine
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@menu.Name</h5>
                            <p class="card-text">
                                <strong>Preț:</strong> @(menu.Price.HasValue ? $"{menu.Price.Value:F2} RON" : "N/A")
                            </p>
                            <p class="card-text">
                                <span class="badge bg-info me-2 badge-primary">@menu.Category</span>
                                @foreach (var restriction in GetRestrictionsList(menu.Restrictions))
                                {
                                    <span class="badge bg-warning me-1 allergens-badge">@restriction</span>
                                }
                            </p>
                            
                            @* Add to Cart Button - visible for all authenticated users *@
                            @if (AuthService.IsAuthenticated && menu.Price.HasValue && menu.Price.Value > 0)
                            {
                                <button class="btn btn-success w-100 mb-2" @onclick="async () => await AddToCart(menu)">
                                    <i class="bi bi-cart-plus"></i> Adaugă în coș
                                </button>
                            }
                            
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-secondary w-100" @onclick="() => ToggleMenuItems(menu.Id)">
                                    <span class="bi @(_expandedMenus.Contains(menu.Id) ? "bi-chevron-up" : "bi-chevron-down") btn-outline-secondary"></span>
                                    @(_expandedMenus.Contains(menu.Id) ? "Ascunde" : "Arată") Articole (@menu.ItemIds.Count)
                                </button>
                            </div>
                            
                            @if (_expandedMenus.Contains(menu.Id))
                            {
                                <div class="mt-3">  
                                    @if (_menuItemsCache.ContainsKey(menu.Id))
                                    {
                                        <ul class="list-group list-group-flush">
                                            @foreach (var item in _menuItemsCache[menu.Id])
                                            {
                                                <li class="list-group-item px-0 py-2">
                                                    <small>
                                                        <strong>@item.Name</strong><br />
                                                        <span class="text-muted">@item.Price.ToString("F2") RON</span>
                                                    </small>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <div class="text-center py-2">
                                            <div class="spinner-border spinner-border-sm" role="status">
                                                <span class="visually-hidden">Se încarcă...</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        @if (AuthService.CurrentUser?.Role == "Admin")
                        {
                            <div class="card-footer bg-transparent border-top-0">
                                <div class="d-flex justify-content-between">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToEdit(menu.Id)">
                                        <span class="bi bi-pencil"></span> Modifică
                                    </button>
                                    <button class="btn btn-sm btn-delete" @onclick="() => DeleteMenu(menu.Id)">
                                        <span class="bi bi-trash"></span> Șterge
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    List<MenuDto>? _menus;
    HashSet<Guid> _expandedMenus = new();
    Dictionary<Guid, List<MenuItemDto>> _menuItemsCache = new();
    List<MenuItemDto>? _allMenuItems;
    string _successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await CartService.InitializeAsync();
        await LoadMenus();
        _allMenuItems = await MenuItemService.GetAllMenuItemsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadMenus();
    }

    private async Task LoadMenus()
    {
        _menus = await MenuService.GetAllMenusAsync();
    }

    void GoToCreate()
    {
        Navigation.NavigateTo("/menus/create");
    }

    void GoToEdit(Guid id)
    {
        Navigation.NavigateTo($"/menus/edit/{id}");
    }

    private async Task DeleteMenu(Guid id)
    {
        var response = await MenuService.DeleteMenuAsync(id);
        if (response.IsSuccessStatusCode)
        {
            _menus = await MenuService.GetAllMenusAsync();
            StateHasChanged();
        }
    }

    private void ToggleMenuItems(Guid menuId)
    {
        if (_expandedMenus.Contains(menuId))
        {
            _expandedMenus.Remove(menuId);
        }
        else
        {
            _expandedMenus.Add(menuId);
            
            // Load menu items if not already cached
            if (!_menuItemsCache.ContainsKey(menuId) && _allMenuItems != null)
            {
                var menu = _menus?.FirstOrDefault(m => m.Id == menuId);
                if (menu != null)
                {
                    _menuItemsCache[menuId] = _allMenuItems
                        .Where(item => menu.ItemIds.Contains(item.Id))
                        .ToList();
                }
            }
        }
    }

    private async Task AddToCart(MenuDto menu)
    {
        await CartService.AddItemAsync(menu);
        _successMessage = $"✓ {menu.Name} a fost adăugat în coș!";
        
        // Clear success message after 3 seconds
        _ = Task.Delay(3000).ContinueWith(_ => 
        {
            _successMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        });
    }

    private List<string> GetRestrictionsList(DietaryRestrictions restrictions)
    {
        var list = new List<string>();
    
        // Verifică fiecare flag
        if (restrictions.HasFlag(DietaryRestrictions.LactoseFree))
            list.Add("Fără Lactoză");
        if (restrictions.HasFlag(DietaryRestrictions.GlutenFree))
            list.Add("Fără Gluten");
        if (restrictions.HasFlag(DietaryRestrictions.NutFree))
            list.Add("Fără Nuci");
        if (restrictions.HasFlag(DietaryRestrictions.DairyFree))
            list.Add("Fără Lactate");
        if (restrictions.HasFlag(DietaryRestrictions.NoSeafood))
            list.Add("Fără Fructe de Mare");
        if (restrictions.HasFlag(DietaryRestrictions.FoodAllergyFriendly))
            list.Add("Fără alergeni suplimentari");
        
        return list.Count == 0 ? ["Poate provoca alergii!"] : list;
    }
}
