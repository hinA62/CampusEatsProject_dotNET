@page "/place-order"
@using CampusEatsFrontend.Models.Order
@using CampusEatsFrontend.Models.Menu
@using CampusEatsFrontend.Models.MenuItem
@using CampusEatsFrontend.Services
@using System.Text.Json
@inject MenuService MenuService
@inject MenuItemService MenuItemService
@inject OrderService OrderService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Plasează comanda</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4">
        <span class="bi bi-cart-plus"></span> Plasează comanda
    </h3>

    @if (_isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger">
                <span class="bi bi-exclamation-triangle"></span> @_errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success">
                <span class="bi bi-check-circle"></span> @_successMessage
            </div>
        }

        <div class="row">
            <!-- Menus Selection -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header badge-primary">
                        <h5 class="mb-0"><span class="bi bi-card-list"></span> Alege Meniuri</h5>
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (_menus == null || !_menus.Any())   
                        {
                            <p class="text-muted">Momentan, nu există meniuri disponibile.</p>
                        }
                        else
                        {
                            @foreach (var menu in _menus)
                            {
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="menu-@menu.Id"
                                           @onchange="@((ChangeEventArgs e) => ToggleMenu(menu.Id, e.Value is bool b && b))" />
                                    <label class="form-check-label w-100" for="menu-@menu.Id">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@menu.Name</strong>
                                                <br />
                                                <small class="text-muted">
                                                    <span class="badge badge-primary">@menu.Category</span>
                                                    @menu.ItemIds.Count items
                                                </small>
                                            </div>
                                            <div>
                                                <strong class="text">@(menu.Price?.ToString("F2") ?? "0.00") RON</strong>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Menu Items Selection -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header badge-primary">
                        <h5 class="mb-0"><span class="bi bi-box-seam"></span> Alege feluri de mâncare</h5>
                    </div>
                    <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                        @if (_menuItems == null || !_menuItems.Any())
                        {
                            <p class="text-muted">Momentan, nu există feluri de mâncare disponibile.</p>
                        }
                        else
                        {
                            @foreach (var item in _menuItems)
                            {
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="item-@item.Id"
                                           @onchange="@((ChangeEventArgs e) => ToggleItem(item.Id, e.Value is bool b && b))" />
                                    <label class="form-check-label w-100" for="item-@item.Id">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@item.Name</strong>
                                                @if (item.Allergens != null && item.Allergens.Any())
                                                {
                                                    <br />
                                                    <small class="text-muted">Alergeni: @string.Join(", ", item.Allergens)</small>
                                                }
                                            </div>
                                            <div>
                                                <strong class="text">@item.Price.ToString("F2") RON</strong>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="card shadow mb-4">
            <div class="card-header badge-primary text-white">
                <h5 class="mb-0"><span class="bi bi-receipt"></span> Rezumat Comandă</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Meniuri Selectate: (@_selectedMenus.Count)</h6>
                        @if (_selectedMenus.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var menuId in _selectedMenus)
                                {
                                    var menu = _menus?.FirstOrDefault(m => m.Id == menuId);
                                    @if (menu != null)
                                    {
                                        <li>• @menu.Name - @(menu.Price?.ToString("F2") ?? "0.00") RON</li>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">Nu ai ales niciun meniu.</p>
                        }
                    </div>
                    <div class="col-md-6">
                        <h6>Feluri selectate: (@_selectedItems.Count)</h6>
                        @if (_selectedItems.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var itemId in _selectedItems)
                                {
                                    var item = _menuItems?.FirstOrDefault(i => i.Id == itemId);
                                    @if (item != null)
                                    {
                                        <li>• @item.Name - @item.Price.ToString("F2") RON</li>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">Nu ai ales niciun fel individual.</p>
                        }
                    </div>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <h4>Total:</h4>
                    <h4 class="text">@_totalPrice.ToString("F2") RON</h4>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-between mb-4">
            <button class="btn btn-outline-secondary" @onclick="Cancel">
                <span class="bi bi-x-circle"></span> Anulează
            </button>
            <button class="btn btn-primary btn-lg" @onclick="SubmitOrder" disabled="@(!CanPlaceOrder() || _isPlacingOrder)">
                @if (_isPlacingOrder)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <span class="bi bi-check-circle btn-primary"></span> Plasează Comanda
            </button>
        </div>
    }
</div>

@code {
    private List<MenuDto>? _menus;
    private List<MenuItemDto>? _menuItems;
    private readonly List<Guid> _selectedMenus = new();
    private readonly List<Guid> _selectedItems = new();
    private decimal _totalPrice = 0;
    private bool _isLoading = true;
    private bool _isPlacingOrder = false;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        
        try
        {
            _menus = await MenuService.GetAllMenusAsync();
            _menuItems = await MenuItemService.GetAllMenuItemsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading data: {ex.Message}";
        }
        
        _isLoading = false;
    }

    private void ToggleMenu(Guid menuId, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedMenus.Contains(menuId))
                _selectedMenus.Add(menuId);
        }
        else
        {
            _selectedMenus.Remove(menuId);
        }
        
        CalculateTotal();
    }

    private void ToggleItem(Guid itemId, bool isChecked)
    {
        if (isChecked)
        {
            if (!_selectedItems.Contains(itemId))
                _selectedItems.Add(itemId);
        }
        else
        {
            _selectedItems.Remove(itemId);
        }
        
        CalculateTotal();
    }

    private void CalculateTotal()
    {
        _totalPrice = 0;

        if (_menus != null)
        {
            foreach (var menuId in _selectedMenus)
            {
                var menu = _menus.FirstOrDefault(m => m.Id == menuId);
                if (menu?.Price != null)
                    _totalPrice += menu.Price.Value;
            }
        }

        if (_menuItems != null)
        {
            foreach (var itemId in _selectedItems)
            {
                var item = _menuItems.FirstOrDefault(i => i.Id == itemId);
                if (item != null)
                    _totalPrice += item.Price;
            }
        }
    }

    private bool CanPlaceOrder()
    {
        return _selectedMenus.Any() || _selectedItems.Any();
    }

    private async Task SubmitOrder()
    {
        if (!CanPlaceOrder())
        {
            _errorMessage = "Please select at least one menu or item.";
            return;
        }

        _isPlacingOrder = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            // Navigate directly to payment page with cart data (no order created yet)
            var menuIds = string.Join(",", _selectedMenus);
            var itemIds = string.Join(",", _selectedItems);
            
            await Task.CompletedTask; // Fix CS1998 warning
            Navigation.NavigateTo($"/payment?menus={menuIds}&items={itemIds}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error placing order: {ex.Message}";
        }
        finally
        {
            _isPlacingOrder = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/orders");
    }
}
