@page "/orders"
@using CampusEatsFrontend.Models.Order
@using CampusEatsFrontend.Services
@inject OrderService OrderService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Comenzi</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4">@(_isAdmin ? "All Orders" : "My Orders")</h3>

    <div class="row mb-3">
        <div class="col-md-4">
            <select class="form-select" @bind="_statusFilter">
                <option value="">Toate Statusurile</option>
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary" @onclick="ApplyFilter">Filtrează</button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Se încarcă...</span>
            </div>
        </div>
    }
    else if (_filteredOrders == null || !_filteredOrders.Any())
    {
        <div class="alert alert-info">Nu există comenzi.</div>
    }
    else
    {
        <div class="list-group">
            @if (_filteredOrders != null)
            {
                @foreach (var order in _filteredOrders)
                {
                    <div class="list-group-item list-group-item-action mb-2" style="cursor: pointer;" @onclick="() => NavigateToOrder(order.Id)">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Comandă #@order.Id.ToString().Substring(0, 8)...</strong>
                                <span class="text-muted ms-2">(@order.Price.ToString("F2") RON)</span>
                                <br />
                                <small class="text-muted">Client: @order.ClientId.ToString().Substring(0, 8)... | @(order.MenuIDs.Count) meniuri, @(order.ItemIDs.Count) feluri individuale</small>
                            </div>
                            <div class="d-flex flex-column align-items-end">
                                <span class="badge bg-@GetStatusColor(order.Status) mb-1">@order.Status</span>
                                <small class="text-muted">@order.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <button class="btn btn-sm btn-danger mt-2" @onclick="(e) => CancelOrderFromList(e, order.Id)" @onclick:stopPropagation="true">
                                        Anulează
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<OrderDto>? _allOrders;
    private List<OrderDto>? _filteredOrders;
    private string _statusFilter = "";
    private bool _isLoading = true;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        _isAdmin = AuthService.CurrentUser?.Role == "Admin";
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        _isLoading = true;
        if (_isAdmin)
        {
            _allOrders = await OrderService.GetAllOrdersAsync();
        }
        else if (AuthService.CurrentUser != null)
        {
            _allOrders = await OrderService.GetOrderHistoryAsync(AuthService.CurrentUser.UserId) ?? new List<OrderDto>();
        }
        _filteredOrders = _allOrders;
        _isLoading = false;
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(_statusFilter))
        {
            _filteredOrders = _allOrders;
        }
        else
        {
            var status = Enum.Parse<OrderStatus>(_statusFilter);
            _filteredOrders = _allOrders?.Where(o => o.Status == status).ToList();
        }
    }

    private void NavigateToOrder(Guid orderId)
    {
        Navigation.NavigateTo($"/order/{orderId}?returnUrl=/orders");
    }

    private async Task CancelOrderFromList(MouseEventArgs e, Guid orderId)
    {
        var response = await OrderService.CancelOrderAsync(orderId);
        if (response.IsSuccessStatusCode)
        {
            await LoadOrders();
            ApplyFilter();
        }
    }

    private static string GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "warning",
        OrderStatus.Confirmed => "info",
        OrderStatus.Preparing => "primary",
        OrderStatus.Completed => "success",
        OrderStatus.Cancelled => "danger",
        _ => "secondary"
    };
}
