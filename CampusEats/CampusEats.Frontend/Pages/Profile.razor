@page "/profile"
@using CampusEatsFrontend.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Profil</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Profilul tău</h3>
                    
                    @if (AuthService.IsAuthenticated && AuthService.CurrentUser != null)
                    {
                        <div class="mb-4">
                            <div class="row mb-3">
                                <div class="col-4 fw-bold profile-text">Nume:</div>
                                <div class="col-8">@AuthService.CurrentUser.Username</div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-4 fw-bold profile-text">Rol:</div>
                                <div class="col-8">
                                    <span class="badge role-badge">@AuthService.CurrentUser.Role</span>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <div class="d-grid gap-2">
                            <a href="/change-password" class="btn btn-outline-primary">Modifică Parola</a>
                            <button class="btn btn-primary" @onclick="HandleLogout">Deconectează-te</button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            Nu ești conectat. Pentru a vizualiza profilul, <a href="/login">conectează-te</a>.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
