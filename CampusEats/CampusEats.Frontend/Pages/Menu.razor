@page "/menus"
@inject MenuService MenuService
@using CampusEatsFrontend.Models.Menu
@using CampusEatsFrontend.Services
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Menus - CampusEats</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Menus (Collections)</h3>
        @if (AuthService.CurrentUser?.Role == "Admin")
        {
            <button class="btn btn-primary" @onclick="GoToCreate">
                <span class="bi bi-plus-circle"></span> Create Menu
            </button>
        }
    </div>

    @if (_menus == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (_menus.Count == 0)
    {
        <div class="alert alert-info">No menus created yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Restrictions</th>
                        <th>Price</th>
                        <th># Items</th>
                        @if (AuthService.CurrentUser?.Role == "Admin")
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _menus)
                    {
                        <tr>
                            <td><strong>@m.Name</strong></td>
                            <td><span class="badge bg-info">@m.Category</span></td>
                            <td><span class="badge bg-warning">@m.Restrictions</span></td>
                            <td>@(m.Price.HasValue ? $"${m.Price.Value:F2}" : "N/A")</td>
                            <td>@m.ItemIds.Count items</td>
                            @if (AuthService.CurrentUser?.Role == "Admin")
                            {
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => GoToEdit(m.Id)">
                                        <span class="bi bi-pencil"></span> Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteMenu(m.Id)">
                                        <span class="bi bi-trash"></span> Delete
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    List<MenuDto>? _menus;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await LoadMenus();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadMenus();
    }

    private async Task LoadMenus()
    {
        _menus = await MenuService.GetAllMenusAsync();
    }

    void GoToCreate()
    {
        Navigation.NavigateTo("/menus/create");
    }

    void GoToEdit(Guid id)
    {
        Navigation.NavigateTo($"/menus/edit/{id}");
    }

    private async Task DeleteMenu(Guid id)
    {
        var response = await MenuService.DeleteMenuAsync(id);
        if (response.IsSuccessStatusCode)
        {
            _menus = await MenuService.GetAllMenusAsync();
            StateHasChanged();
        }
    }
}