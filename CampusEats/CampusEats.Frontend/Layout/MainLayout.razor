@inherits LayoutComponentBase
@using CampusEatsFrontend.Services
@inject AuthService AuthService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-bar">
            <div class="container-fluid d-flex justify-content-between align-items-center py-2 px-4">
                <div>
                    @if (AuthService.CurrentUser?.Role == "Admin")
                    {
                        <div class="btn-group" role="group">
                            <a href="/menu-items" class="btn btn-sm btn-outline-secondary">
                                <span class="bi bi-box-seam"></span> Menu Items
                            </a>
                            <a href="/menus" class="btn btn-sm btn-outline-secondary">
                                <span class="bi bi-card-list"></span> Menus
                            </a>
                            <a href="/orders" class="btn btn-sm btn-outline-secondary">
                                <span class="bi bi-clipboard-check"></span> Orders
                            </a>
                            <a href="/kitchen" class="btn btn-sm btn-outline-secondary">
                                <span class="bi bi-fire"></span> Kitchen
                            </a>
                        </div>
                    }
                </div>
                
                <div>
                    @if (AuthService.IsAuthenticated && AuthService.CurrentUser != null)
                    {
                        <a href="/profile" class="btn btn-outline-primary">
                            <span class="bi bi-person-circle"></span> @AuthService.CurrentUser.Username
                        </a>
                    }
                    else
                    {
                        <a href="/login" class="btn btn-primary me-2">Login</a>
                        <a href="/register" class="btn btn-outline-primary">Register</a>
                    }
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        StateHasChanged();
    }
}

