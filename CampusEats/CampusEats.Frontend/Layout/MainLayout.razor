@inherits LayoutComponentBase
@using CampusEatsFrontend.Services
@using CampusEatsFrontend.Pages.Cart
@inject AuthService AuthService
@inject CartService CartService

<div class="page">
    <div class="sidebar">
        <NavMenu OnCartButtonClick="OpenCartSidebar" />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<CartSidebar @ref="_cartSidebar" />

@code {
    private CartSidebar? _cartSidebar;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await CartService.InitializeAsync();
    }

    private void OpenCartSidebar()
    {
        _cartSidebar?.Open();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        StateHasChanged();
    }
}
