@using CampusEatsFrontend.Services
@inject AuthService AuthService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CampusEats</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (AuthService.CurrentUser?.Role == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menu-items">
                    <span class="bi bi-box-seam" aria-hidden="true"></span> Menu Items
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menus">
                    <span class="bi bi-card-list" aria-hidden="true"></span> Menus
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="orders">
                    <span class="bi bi-clipboard-check" aria-hidden="true"></span> Orders
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="clients">
                    <span class="bi bi-people-fill" aria-hidden="true"></span> Clients
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="place-order">
                    <span class="bi bi-cart-plus" aria-hidden="true"></span> Place Order
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="kitchen">
                    <span class="bi bi-fire" aria-hidden="true"></span> Kitchen
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="loyalty">
                    <span class="bi bi-star-fill" aria-hidden="true"></span> Loyalty
                </NavLink>
            </div>
        }
        else if (AuthService.CurrentUser?.Role == "Kitchen")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="kitchen">
                    <span class="bi bi-fire" aria-hidden="true"></span> Kitchen Dashboard
                </NavLink>
            </div>
        }
        else if (AuthService.CurrentUser?.Role == "Client")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menus">
                    <span class="bi bi-card-list" aria-hidden="true"></span> Menus
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menu-items">
                    <span class="bi bi-box-seam" aria-hidden="true"></span> Menu Items
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="orders">
                    <span class="bi bi-clipboard-check" aria-hidden="true"></span> Orders
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="place-order">
                    <span class="bi bi-cart-plus" aria-hidden="true"></span> Place Order
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="loyalty">
                    <span class="bi bi-star-fill" aria-hidden="true"></span> Loyalty
                </NavLink>
            </div>
        }

        @if (AuthService.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profile">
                    <span class="bi bi-person-circle" aria-hidden="true"></span> Profile
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
    }
}
