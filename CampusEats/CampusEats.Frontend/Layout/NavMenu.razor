@using CampusEatsFrontend.Services
@inject AuthService AuthService
@inject CartService CartService
@inject NavigationManager Navigation
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a href="/" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
            
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 10C4 14.4183 7.58172 18 12 18C16.4183 18 20 14.4183 20 10V9H4V10Z" fill="#10b981"/>
                <path d="M7 4C7 5.5 8 6 8 7" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"/>
                <path d="M12 2C12 4 13 5 13 7" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"/>
                <path d="M17 3C17 4.5 18 5 18 6" stroke="#f59e0b" stroke-width="2" stroke-linecap="round"/>
            </svg>

            <div style="font-family: 'Quicksand', 'Varela Round', 'Segoe UI Soft', sans-serif; font-size: 26px; font-weight: 600; color: #f59e0b;">
                CampusEats
            </div>
        </a>
        <div class="d-flex align-items-center gap-3">
            @* Cart Button with Badge *@
            @if (AuthService.IsAuthenticated)
            {
                <button class="btn btn-link text-white position-relative p-0 cart-button" @onclick="OpenCartSidebar" @onclick:stopPropagation="true" title="Coș de cumpărături">
                    <i class="bi bi-cart3" style="font-size: 1.5rem;"></i>
                    @if (CartService.TotalItems > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger pulse-badge" style="font-size: 0.75rem;">
                            @CartService.TotalItems
                        </span>
                    }
                </button>
            }
            <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </div>
</div>

<style>
    .cart-button {
        transition: all 0.3s ease;
        text-decoration: none !important;
        z-index: 1000;
        border: none;
        background: transparent;
    }
    
    .cart-button:hover {
        transform: scale(1.1);
        filter: brightness(1.2);
        text-decoration: none !important;
    }
    
    .cart-button:active {
        transform: scale(0.95);
    }
    
    .cart-button:focus {
        outline: none;
        box-shadow: none;
    }
    
    .pulse-badge {
        animation: pulse 2s infinite;
        z-index: 1001;
    }
    
    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
        }
        70% {
            box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
        }
        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }
</style>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (AuthService.CurrentUser?.Role == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menu-items">
                    <span class="bi bi-box-seam" aria-hidden="true"></span> Menu Items
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menus">
                    <span class="bi bi-card-list" aria-hidden="true"></span> Menus
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="orders">
                    <span class="bi bi-clipboard-check" aria-hidden="true"></span> Orders
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="clients">
                    <span class="bi bi-people-fill" aria-hidden="true"></span> Clients
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="kitchen">
                    <span class="bi bi-fire" aria-hidden="true"></span> Kitchen
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="loyalty">
                    <span class="bi bi-star-fill" aria-hidden="true"></span> Loyalty
                </NavLink>
            </div>
        }
        else if (AuthService.CurrentUser?.Role == "Kitchen")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="kitchen">
                    <span class="bi bi-fire" aria-hidden="true"></span> Kitchen Dashboard
                </NavLink>
            </div>
        }
        else if (AuthService.CurrentUser?.Role == "Client")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menus">
                    <span class="bi bi-card-list" aria-hidden="true"></span> Menus
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="menu-items">
                    <span class="bi bi-box-seam" aria-hidden="true"></span> Menu Items
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="orders">
                    <span class="bi bi-clipboard-check" aria-hidden="true"></span> Orders
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="loyalty">
                    <span class="bi bi-star-fill" aria-hidden="true"></span> Loyalty
                </NavLink>
            </div>
        }

        @if (AuthService.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profile">
                    <span class="bi bi-person-circle" aria-hidden="true"></span> Profile
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    
    [Parameter]
    public EventCallback OnCartButtonClick { get; set; }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await CartService.InitializeAsync();
        CartService.OnChange += StateHasChanged;
    }

    private async Task OpenCartSidebar()
    {
        await OnCartButtonClick.InvokeAsync();
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
}
